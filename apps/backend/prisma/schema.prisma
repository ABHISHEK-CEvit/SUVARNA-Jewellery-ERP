datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  name         String
  passwordHash String
  role         String    @default("STAFF")
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  salesInvoices SalesInvoice[]
  auditLogs     AuditLog[]
}

model BusinessSettings {
  id               String   @id @default("default")
  shopName         String   @default("My Jewellery Shop")
  tagline          String?
  address          String?
  city             String?
  state            String?  @default("Maharashtra")
  stateCode        String?  @default("27")
  phone            String?
  email            String?
  gstin            String?
  pan              String?
  bankName         String?
  bankAccountNo    String?
  bankIfsc         String?
  invoicePrefix    String   @default("INV")
  termsConditions  String?
  defaultGstRate   Decimal  @default(3.00) @db.Decimal(5, 2)
  todayGold22kRate Decimal  @default(0.00) @db.Decimal(10, 2)
  todayGold24kRate Decimal  @default(0.00) @db.Decimal(10, 2)
  todayGold18kRate Decimal  @default(0.00) @db.Decimal(10, 2)
  todayGold20kRate Decimal  @default(0.00) @db.Decimal(10, 2)
  todayGold14kRate Decimal  @default(0.00) @db.Decimal(10, 2)
  todaySilverRate  Decimal  @default(0.00) @db.Decimal(10, 2)
  updatedAt        DateTime @updatedAt
}

model Category {
  id             String    @id @default(uuid())
  name           String    @unique
  metalType      String    @default("GOLD")
  defaultPurity  String?   // e.g. "916", "750"
  defaultHsnCode String    @default("7113")
  gstRate        Decimal   @default(3.00) @db.Decimal(5, 2)
  discountRate   Decimal   @default(0.00) @db.Decimal(5, 2)
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())

  salesItems     SalesInvoiceItem[]
}

model Customer {
  id                 String    @id @default(uuid())
  name               String
  phone              String?
  email              String?
  address            String?
  city               String?
  state              String?
  pan                String?
  gstin              String?
  openingBalance     Decimal   @default(0.00) @db.Decimal(12, 2)
  openingBalanceType String    @default("DEBIT") // "DEBIT" or "CREDIT"
  currentBalance     Decimal   @default(0.00) @db.Decimal(12, 2)
  isActive           Boolean   @default(true)
  createdAt          DateTime  @default(now())

  salesInvoices   SalesInvoice[]
  ledgerEntries   CustomerLedgerEntry[]
  paymentReceipts PaymentReceipt[]

  @@index([phone])
}

model DailyMetalRate {
  id           String   @id @default(uuid())
  rateDate     DateTime @default(now()) @db.Date
  gold22kRate  Decimal  @db.Decimal(10, 2)
  gold24kRate  Decimal  @db.Decimal(10, 2)
  gold18kRate  Decimal  @default(0.00) @db.Decimal(10, 2)
  gold20kRate  Decimal  @default(0.00) @db.Decimal(10, 2)
  gold14kRate  Decimal  @default(0.00) @db.Decimal(10, 2)
  silverRate   Decimal  @db.Decimal(10, 2)
  createdById  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([rateDate])
  @@index([rateDate])
}

model SalesInvoice {
  id               String        @id @default(uuid())
  invoiceNumber    String        @unique
  invoiceDate      DateTime      @default(now())
  customerId       String?
  customer         Customer?     @relation(fields: [customerId], references: [id])
  customerName     String
  customerPhone    String?

  // Rate Snapshots
  goldRate22k               Decimal       @db.Decimal(10, 2)
  goldRate24k               Decimal       @db.Decimal(10, 2)
  goldRate18k               Decimal?      @db.Decimal(10, 2)
  goldRate20k               Decimal?      @db.Decimal(10, 2)
  goldRate14k               Decimal?      @db.Decimal(10, 2)
  silverRate                Decimal?      @db.Decimal(10, 2)

  // Revenue Totals
  grossItemsAmount          Decimal       @db.Decimal(12, 2)
  oldGoldDeduction          Decimal       @default(0.00) @db.Decimal(12, 2)
  totalDiscount             Decimal       @default(0.00) @db.Decimal(12, 2)
  overallDiscountPercentage Decimal?      @default(0.00) @db.Decimal(5, 2)
  overallDiscountAmount     Decimal?      @default(0.00) @db.Decimal(12, 2)
  taxableAmount             Decimal       @db.Decimal(12, 2)
  gstRate                   Decimal       @default(3.00) @db.Decimal(5, 2)
  cgstAmount                Decimal       @default(0.00) @db.Decimal(12, 2)
  sgstAmount                Decimal       @default(0.00) @db.Decimal(12, 2)
  igstAmount                Decimal       @default(0.00) @db.Decimal(12, 2)
  totalTaxAmount            Decimal       @db.Decimal(12, 2)
  roundOff                  Decimal       @default(0.00) @db.Decimal(5, 2)
  netAmount                 Decimal       @db.Decimal(12, 2)

  paidAmount                Decimal       @default(0.00) @db.Decimal(12, 2)
  balanceAmount             Decimal       @default(0.00) @db.Decimal(12, 2)

  status                    String        @default("ACTIVE") // ACTIVE, INVALID
  notes                     String?
  createdById               String
  createdBy                 User          @relation(fields: [createdById], references: [id])
  editCount                 Int           @default(0)
  lastEditedAt              DateTime?
  lastEditedById            String?
  invalidatedAt             DateTime?
  invalidatedById           String?
  invalidationReason        String?
  restoredAt                DateTime?
  restoredById              String?
  createdAt                 DateTime      @default(now())
  updatedAt                 DateTime      @updatedAt

  items              SalesInvoiceItem[]
  oldGoldExchanges   OldGoldExchangeItem[]
  payments           PaymentReceipt[]
  ledgerEntries      CustomerLedgerEntry[]
  history            SalesInvoiceHistory[]
  correctionRequests BillCorrectionRequest[]
}

model SalesInvoiceItem {
  id                 String           @id @default(uuid())
  invoiceId          String
  invoice            SalesInvoice     @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  categoryId         String?
  category           Category?        @relation(fields: [categoryId], references: [id])
  categoryName       String           @default("")
  description        String
  designStyle        String?

  // Weights (3 Decimal Precision: 0.001g)
  grossWeight        Decimal          @default(0.000) @db.Decimal(12, 3)
  stoneWeight        Decimal          @default(0.000) @db.Decimal(12, 3)
  stoneCarat         Decimal?         @default(0.00) @db.Decimal(8, 2)
  netWeight          Decimal          @db.Decimal(12, 3)

  metalType          String           @default("GOLD")
  purity             String
  metalRatePerGram   Decimal          @db.Decimal(10, 2)
  ratePerTola        Decimal?         @db.Decimal(10, 2)
  metalValue         Decimal          @db.Decimal(12, 2)

  hasStone           Boolean          @default(false)
  stoneType          String?
  stoneCharges       Decimal          @default(0.00) @db.Decimal(12, 2)

  makingCharges      Decimal          @default(0.00) @db.Decimal(12, 2)
  makingChargeType   String           @default("PER_GRAM")
  makingChargeRate   Decimal          @default(0.00) @db.Decimal(10, 2)
  totalMakingCharge  Decimal          @default(0.00) @db.Decimal(12, 2)

  stoneValue         Decimal          @default(0.00) @db.Decimal(12, 2)
  wastagePercentage  Decimal          @default(0.00) @db.Decimal(5, 2)

  discountApplicable Boolean          @default(false)
  discountPercentage Decimal          @default(0.00) @db.Decimal(5, 2)
  discountAmount     Decimal          @default(0.00) @db.Decimal(12, 2)

  itemSubtotal       Decimal          @default(0.00) @db.Decimal(12, 2)
  taxableAmount      Decimal          @default(0.00) @db.Decimal(12, 2)
  gstRate            Decimal          @default(3.00) @db.Decimal(5, 2)
  gstAmount          Decimal          @default(0.00) @db.Decimal(12, 2)
  totalItemAmount    Decimal          @db.Decimal(12, 2)
  hsnCode            String           @default("7113")
}

model SalesInvoiceHistory {
  id            String       @id @default(uuid())
  invoiceId     String
  invoice       SalesInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  version       Int
  snapshot      String       @db.Text
  changeReason  String?
  changedById   String
  changedByName String
  changedByRole String
  changedFields String?      @db.Text
  createdAt     DateTime     @default(now())

  @@index([invoiceId])
}

model BillCorrectionRequest {
  id              String       @id @default(uuid())
  invoiceId       String
  invoice         SalesInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  requestedById   String
  requestedByName String
  requestedByRole String
  reason          String
  status          String       @default("PENDING") // PENDING, RESOLVED, REJECTED
  resolvedById    String?
  resolvedByName  String?
  resolutionNotes String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([invoiceId])
  @@index([status])
}

model OldGoldExchangeItem {
  id                   String       @id @default(uuid())
  invoiceId            String
  invoice              SalesInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description          String
  grossWeight          Decimal      @db.Decimal(12, 3)
  dustMeltingDeduction Decimal      @default(0.000) @db.Decimal(12, 3)
  netFineWeight        Decimal      @db.Decimal(12, 3)
  purityPercentage     Decimal      @db.Decimal(5, 2)
  ratePerGram          Decimal      @db.Decimal(10, 2)
  totalExchangeValue   Decimal      @db.Decimal(12, 2)
}

model PaymentReceipt {
  id              String      @id @default(uuid())
  receiptNumber   String      @unique
  date            DateTime    @default(now())
  invoiceId       String?
  invoice         SalesInvoice? @relation(fields: [invoiceId], references: [id])
  customerId      String?
  customer        Customer?   @relation(fields: [customerId], references: [id])
  paymentMode     String      @default("CASH")
  amount          Decimal     @db.Decimal(12, 2)
  referenceNumber String?
  notes           String?
  createdAt       DateTime    @default(now())
}

model CustomerLedgerEntry {
  id                 String        @id @default(uuid())
  customerId         String
  customer           Customer      @relation(fields: [customerId], references: [id])
  date               DateTime      @default(now())
  entryType          String
  debitAmount        Decimal       @default(0.00) @db.Decimal(12, 2)
  creditAmount       Decimal       @default(0.00) @db.Decimal(12, 2)
  runningBalance     Decimal       @db.Decimal(12, 2)
  referenceInvoiceId String?
  referenceInvoice   SalesInvoice? @relation(fields: [referenceInvoiceId], references: [id])
  remarks            String?
  createdAt          DateTime      @default(now())
}

model AuditLog {
  id            String   @id @default(uuid())
  entityType    String
  entityId      String
  action        String
  performedById String
  performedBy   User     @relation(fields: [performedById], references: [id])
  oldValues     String?
  newValues     String?
  ipAddress     String?
  timestamp     DateTime @default(now())
}
